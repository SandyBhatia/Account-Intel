From 5a4f9053a5ba35bc0ff74708fe60452f17521b66 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 16 Aug 2026 01:16:53 +0000
Subject: [PATCH] Phase 1: fix live gaps

- .env.example / README: document ADMIN_EMAILS (missing var was hiding the
  Import tool on any fresh deploy, including the current one if unset)
- FinancialsPanel: add optional sources field + render a source line under
  the financial exhibit, matching the existing exhibit-sources pattern.
  Purely additive - renders nothing when a baseline has no financials.sources.
- Backfill financials.sources with verified primary-source URLs for the
  three complete accounts (CN 5/8 quarters, CPKC 8/8, UPS 8/8). Spot-checked
  two filings end-to-end (UPS Q2'26, CN Q3'25) against the numbers already
  in the JSON - all matched exactly. CN Q4'25/Q1'26/Q2'26 still need their
  source URLs found (noted, not guessed).
- No schema change: financials is already jsonb, no SQL migration needed.
- API validation intentionally left unchanged (still exhibit-sources-only)
  since 15 of 18 baselines don't have financials.sources yet - enforcing it
  now would break the bulk Import loader. Recommend enforcing once backfill
  finishes.
---
 .env.example                   |  7 +++++++
 README.md                      | 16 ++++++++++++++-
 components/FinancialsPanel.tsx | 12 ++++++++++++
 data/baselines/03-cn.json      | 36 +++++++++++++++++++++++++++++++++-
 data/baselines/05-ups.json     | 36 +++++++++++++++++++++++++++++++++-
 data/baselines/10-cpkc.json    | 36 +++++++++++++++++++++++++++++++++-
 6 files changed, 139 insertions(+), 4 deletions(-)

diff --git a/.env.example b/.env.example
index 2999fed..47831ee 100644
--- a/.env.example
+++ b/.env.example
@@ -7,3 +7,10 @@ ANTHROPIC_API_KEY=
 ANTHROPIC_MODEL=claude-sonnet-4-5
 
 NEXT_PUBLIC_SITE_URL=http://localhost:3000
+
+# --- Admin gate — server-side only ---
+# Comma-separated emails allowed to see /admin and use the Import tool
+# (single import + "Load all bundled baselines"). Leave unset/empty and
+# nobody sees Import — that is the safe default for a shared trial.
+# Example: ADMIN_EMAILS=sandy@mphasis.com,ravi@mphasis.com
+ADMIN_EMAILS=
diff --git a/README.md b/README.md
index 5606fd3..b4698e3 100644
--- a/README.md
+++ b/README.md
@@ -57,7 +57,9 @@ Knowing is automatic; doing is deliberate.
    | `ANTHROPIC_API_KEY` | from step 2 |
    | `ANTHROPIC_MODEL` | `claude-sonnet-4-5` |
    | `NEXT_PUBLIC_SITE_URL` | your Vercel URL after first deploy |
+   | `ADMIN_EMAILS` | comma-separated emails allowed to see **Import** (e.g. yours). Unset = nobody sees it — the safe default for a shared trial. |
 4. Deploy. Open the URL → create your account on the sign-in screen → you're in.
+   Without `ADMIN_EMAILS` set to at least your own address, the Import tool stays hidden from everyone, including you.
 
 ### Local dev
 ```bash
@@ -91,8 +93,20 @@ npm run dev
     "table": { "head": ["", "FY25"], "rows": [["Revenue", "1,100"]] },
     "sowhat": "Why it matters.",
     "sources": [{ "label": "FY25 10-K p.30", "url": "https://..." }]
-  }]
+  }],
+  "financials": {
+    "currency": "US$", "unit": "millions",
+    "periods": ["Q3'24", "Q4'24", "Q1'25", "Q2'25", "Q3'25", "Q4'25", "Q1'26", "Q2'26"],
+    "basis": "Free-text note on comparability, fiscal-year quirks, etc.",
+    "series": [{ "label": "Revenue", "kind": "currency", "values": [4110, 4358, null, 4272, 4165, null, 4379, 4753], "headline": true }],
+    "sources": [{ "label": "Q2 2026 10-Q", "url": "https://..." }]
+  }
 }
 ```
 
+`financials.sources` carries the primary filings/press releases the series values were read from — the same
+evidence standard as exhibits, rendered the same way (a clickable source line under the panel). It is not yet
+enforced at the API layer; see the data-completeness note in `HANDOFF.md` before treating an account's
+financials as fully sourced.
+
 Reaffirm mode: same endpoint with `"mode": "reaffirm"` — stamps `last_reviewed`, no new version.
diff --git a/components/FinancialsPanel.tsx b/components/FinancialsPanel.tsx
index 60037ec..5f0c530 100644
--- a/components/FinancialsPanel.tsx
+++ b/components/FinancialsPanel.tsx
@@ -32,6 +32,10 @@ export interface Financials {
   periods: string[];      // ["Q3'24", ... "Q2'26"] or ["FY2021", ...]
   basis?: string;         // e.g. "Segment results within FedEx Corp, not carve-out"
   series: FinancialSeries[];
+  /** The filings/press releases these values were read from. Same evidence
+   *  standard as exhibit sources — rendered the same way. Not yet enforced
+   *  at the API layer; many baselines still carry only the `basis` note. */
+  sources?: { label: string; url?: string }[];
 }
 
 const fmt = (v: number | null, kind: string, cur = "") => {
@@ -140,6 +144,14 @@ export default function FinancialsPanel({ fin }: { fin: Financials }) {
           </p>
         )}
       </div>
+
+      {fin.sources && fin.sources.length > 0 && (
+        <div className="src">
+          {fin.sources.map((s, i) => (
+            <span key={i}>{i > 0 && " · "}{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.label} ↗</a> : s.label}</span>
+          ))}
+        </div>
+      )}
     </div>
   );
 }
